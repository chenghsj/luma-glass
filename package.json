{
  "name": "@chenghsj/luma-glass",
  "version": "0.1.0",
  "description": "Adjustable optical glass components for React",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "preview": "vite preview",
    "build:demo": "vite build --mode pages",
    "preview:demo": "vite preview --mode pages --outDir dist-demo",
    "sync:pages": "npm run build:pages:standalone",
    "build:pages": "vite build --mode pages-release && node scripts/finish-pages.mjs",
    "build:pages:standalone": "node scripts/build-pages-standalone.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
